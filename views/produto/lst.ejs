<%-include('../cabecalho.ejs')%>
    <h1>Produto</h1>
    <div>
        <form action="
        " method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/produto/add">+ Produto</a>
    <table>
        <tr>
            <th>Nome</th>
            <th>Detalhes</th>
            <th>Quantidade</th>
            <th>Preco</th>
            <th>Imagem</th>
            <th>Categoria</th>
            <th>Fornecedor</th>
            <th>Acoes</th>
        </tr>

        <%Produto.forEach(function(p){ %>

            <tr>
                <td>
                    <%=p.nome%>
                </td>
                <td>
                    <%=p.detalhes%>
                </td>
                <td>
                    <%=p.quantidade%>
                </td>
                <td>
                   R$<%=p.preco.toFixed(2)%>
                </td>
                <td><img src="<%=p.foto%>" width="150" height="100"></td>
                <td>
                    <%= p.categoria ? p.categoria.nome : '' %>
                </td>
                <td>
                    <%= p.fornecedor ? p.fornecedor.nome : '' %>
                </td>
                <td><a class="btn edit" href="/produto/edt/<%=p.id%>">Editar</a>
                    <a class="btn delete" href="/produto/del/<%=p.id%>">Excluir</a>
                </td>
            </tr>
            <%})%>
    </table>
    <%-include('../rodape.ejs')%>