<%-include('../cabecalho.ejs')%>
    <h1>Produto</h1>
    <div>
        <form action="
        " method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/produto/add">+ Produto</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Detalhes</td>
            <td>Quantidade</td>
            <td>Preco</td>
            <td>Imagem</td>
            <td>Categoria</td>
            <td>Fornecedor</td>
            <td>Acoes</td>
        </tr>
  
        <%Produto.forEach(function(p){ %>

            <tr>
                <td>
                    <%=p.nome%>
                </td>
                <td>
                    <%=p.detalhes%>
                </td>
                <td>
                    <%=p.quantidade%>
                </td>
                <td>
                    <%=p.preco%>
                </td>
                <td><img src="<%=p.foto%>" width="150" height="100"></td>
                <td>
                    <%= p.categoria ? p.categoria.nome : '' %>
                </td>
                <td>
                    <%= p.fornecedor ? p.fornecedor.nome : '' %>
                </td>
                <td><a href="/produto/edt/<%=p.id%>">Editar</a>
                    <a href="/produto/del/<%=p.id%>">Excluir</a>
                </td>
            </tr>
            <%})%>
    </table>
    <%-include('../rodape.ejs')%>