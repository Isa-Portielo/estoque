<%-include('../cabecalho.ejs')%>
    <h1>Produto</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/produto/add">+ Produto</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Detalhes</td>
            <td>Quantidade</td>
            <td>Preço</td>
            <td>Categoria</td>
            <td>Fornecedor</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, nome, detalhes, quantidade, preco, categoria, fornecedor} of Produto) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=detalhes%></td>
            <td><%=quantidade%></td>
            <td><%=preco%></td>
            <td><%=Categoria%></td>
            <td><%=Fornecedor%></td>
            <td><a href="/produto/edt/<%=id%>">Editar</a>
            <a href="/produto/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>
 <%-include('../rodape.ejs')%>