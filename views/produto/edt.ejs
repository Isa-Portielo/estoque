<%-include('../cabecalho.ejs')%>
<h1>Editar Produto</h1>
<div>
<a href="/produto/lst">Listar</a>
</div>
<div>
    <form  method="post" enctype="multipart/form-data">
       
        <label>Nome:</label>
        <input type="text" name="nome" value="<%=Produto.nome%>"><br>

        <label>Detalhes:</label>
        <input type="text" name="detalhes" value="<%=Produto.detalhes%>"><br>

        <label>Preço:</label>
        <input type="number" name="preco" value="<%=Produto.preco%>"><br>

    </br>
        <label for="fotoprod">Foto:</label>
        <img src="<%=Produto.foto%>" width="150" height="100">
        <input type="file" id="foto" name="foto" value="<%=Produto.foto%>">
</br>
        <label>Categoria:</label>
            <select name="categoria">
            <option value="">selecione</option>
                <% Categoria.forEach(categoria => { %>
                <option value='<%= categoria.id %>' 
                <%= (Produto.categoria && categoria.id.toString() === Produto.categoria.toString()) ? 'selected' : '' %> >
                    <%= categoria.nome %>
                    </option>
                <% }) %>
            </select><br>
</br>
        <label>Fornecedor:</label>
            <select name="fornecedor">
                <% Fornecedor.forEach(fornecedor => { %>
                    <option value="<%= fornecedor.id %>" 
                     <%= (Produto.fornecedor && fornecedor.id.toString() === Produto.fornecedor.toString()) ? 'selected' : '' %>>
                    <%= fornecedor.nome %>
                    </option>
                <% }) %>
            </select><br>

        
        <button type="submit">Editar</button>
    </form>
</div>

<%-include('../rodape.ejs')%>