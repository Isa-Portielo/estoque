<%-include('../cabecalho.ejs')%>
<h1>Editar registro</h1>
<div>
<a href="/registro/lst">Listar</a>
</div>
<div>
    <form  method="post">
       
        <input type="hidden" name="id" value="<%=Registro.id%>"><br>

        <label>Produto:</label>
            <select name="produto">
            <option value="">selecione</option>
                <% Produto.forEach(produto => { %>
                <option value='<%= produto.id %>' 
                <%= (Registro.produto && produto.id.toString() === Registro.produto.toString()) ? 'selected' : '' %> >
                    <%= produto.nome %>
                    </option>
                <% }) %>
            </select><br>

        <label>Tipo:</label>
            <select name="tipo">
                <option value="<%=Registro.tipo%>"> <%=Registro.tipo%> </option>
                <option value="<%=(Registro.tipo === 'Entrada') ? 'Saida' : 'Entrada'%>"> <%= (Registro.tipo === 'Entrada') ? 'Saida' : 'Entrada' %> </option>
            </select><br>

        <label>Quantidade:</label>
            <input type="number" name="quantidade" value="<%=Registro.quantidade%>"><br>

         <label>Data:</label>
            <input type="text" name="data" value="<%=Registro.data %>"><br>
        <label>Horário:</label>
            <input type="time" name="hora" value="<%=Registro.hora%>"><br>

        <button type="submit">Editar</button>
    </form>
</div>

<%-include('../rodape.ejs')%>