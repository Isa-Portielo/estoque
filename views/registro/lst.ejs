<%-include('../cabecalho.ejs')%>
    <h1>Registro</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o registro">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/registro/add">+ Registro</a>
    <table>
        <tr>
            <td>Produto</td>
            <td>Tipo</td>
            <td>Quantidade</td>
            <td>Data</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, produto, tipo, quantidade, data} of Registro) {%>
        <tr>
            <td><%=registro.produto.nome%></td>
            <td><%=tipo%></td>
            <td><%=quantidade%></td>
            <td><%=data%></td>
            <td><a href="/registro/edt/<%=id%>">Editar</a>
            <a href="/registro/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>
 <%-include('../rodape.ejs')%>