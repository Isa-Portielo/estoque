<%-include('../cabecalho.ejs')%>
    <h1>Registro</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o registro">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/registro/add">+ Registro</a>
    <table>
        <tr>
            <td>Produto</td>
            <td>Tipo</td>
            <td>Quantidade</td>
            <td>Data</td>
            <td>Horário</td>
            <td>Ações</td>
        </tr>
      
        <%Registro.forEach(function(r){ %>
        <tr>
            <td><%= r.produto ? r.produto.nome : '' %></td>
            <td><%=r.tipo%></td>
            <td><%=r.quantidade%></td>
            <td><%=r.data%></td>
            <td><%=r.hora%></td>
            <td><a href="/registro/edt/<%=r.id%>">Editar</a>
            <a href="/registro/del/<%=r.id%>">Excluir</a></td>
        </tr>
        <%})%>
    </table>
 <%-include('../rodape.ejs')%>