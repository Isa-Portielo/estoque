<%-include('../cabecalho.ejs')%>
    <h1>Fornecedores</h1>
    <div>
        <form action=" " method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/fornecedor/add">+ Fornecedor</a>
    <table>
        <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>Email</th>
            <th>Celular</th>
            <th>Ações</th>
        </tr>

        <%for (const {id, nome, cpf, email, celular} of Fornecedor) {%>
            <tr>
                <td>
                    <%=nome%>
                </td>
                <td>
                    <%=cpf%>
                </td>
                <td>
                    <%=email%>
                </td>
                <td>
                    <%=celular%>
                </td>
                <td><a class="btn edit" href="/fornecedor/edt/<%=id%>">Editar</a>
                    <a class="btn delete" href="/fornecedor/del/<%=id%>">Excluir</a>
                </td>
            </tr>
            <%}%>
    </table>
    <%-include('../rodape.ejs')%>