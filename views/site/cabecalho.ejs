<!doctype html>
<ejs lang="pt-BR">

  <head>


  
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gerenciador de estoque — versão estática" />
    <title>Visão geral | Estoque</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet" />
    <link rel="stylesheet" href="/css/stylesStatic.css" />
  </head>

  <body>
    <svg class="svg-defs" aria-hidden="true">
      <symbol id="i-archive" viewBox="0 0 24 24">
        <path d="M4 7h16v13H4zM3 3h18v4H3zM9 11h6" />
      </symbol>
      <symbol id="home" viewBox="0 0 24 24">
        <path d="M3 10.5 12 3l9 7.5" />
        <path d="M5.5 9.5V21h13V9.5M9 21v-7h6v7" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path d="m4 7 8-4 8 4-8 4-8-4Z" />
        <path d="m4 7v10l8 4 8-4V7M12 11v10" />
      </symbol>
      <symbol id="i-swap" viewBox="0 0 24 24">
        <path d="M4 8h13l-3-3M20 16H7l3 3" />
      </symbol>
      <symbol id="i-settings" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3" />
        <path
          d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4-4" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </symbol>
      <symbol id="i-close" viewBox="0 0 24 24">
        <path d="m6 6 12 12M18 6 6 18" />
      </symbol>
      <symbol id="i-chevron" viewBox="0 0 24 24">
        <path d="m9 18 6-6-6-6" />
      </symbol>
      <symbol id="i-down" viewBox="0 0 24 24">
        <path d="M12 4v15M6 13l6 6 6-6" />
      </symbol>
      <symbol id="i-up" viewBox="0 0 24 24">
        <path d="M12 20V5M6 11l6-6 6 6" />
      </symbol>
      <symbol id="i-plus" viewBox="0 0 24 24">
        <path d="M12 5v14M5 12h14" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M7 3v4M17 3v4M3 10h18" />
      </symbol>
    </svg>

    <header class="topbar">
      <button class="icon-button mobile-menu" id="open-menu" aria-label="Abrir menu"><svg>
          <use href="#i-menu" />
        </svg></button>
      <a class="brand" href="/site/" aria-label="Ir para a visão geral">
        <span class="brand-mark"><svg>
            <use href="#i-archive" />
          </svg></span>
        <span>Estoque<span class="brand-dot">.</span></span>
      </a>
      <div class="header-actions">
        <div class="font-controls" aria-label="Controle de tamanho da fonte">
          <button id="font-down" aria-label="Diminuir fonte">A−</button>
          <button id="font-up" aria-label="Aumentar fonte">A+</button>
        </div>
        <button class="icon-button notification" aria-label="Notificações"><svg>
            <use href="#i-bell" />
          </svg><span></span></button>
        <button class="avatar-button" aria-label="Perfil de Marina Costa">
          <span class="avatar">MC</span>
          <span class="avatar-copy"><strong>Marina Costa</strong><small>Operadora de
              estoque</small></span>
          <svg>
            <use href="#i-chevron" />
          </svg>
        </button>
      </div>
    </header>

    <aside class="sidebar" id="sidebar" aria-label="Menu principal">
      <button class="icon-button close-menu" id="close-menu" aria-label="Fechar menu"><svg>
          <use href="#i-close" />
        </svg></button>
      <nav>
        <p class="nav-label">MENU PRINCIPAL</p>
        <a class="nav-item active" href="/site" data-route="dashboard">
          <svg>
            <use href="#home" />
          </svg>
          <span>Visão geral</span>
        </a>
        <a class="nav-item" href="/site/produtos" data-route="products">
          <svg>
            <use href="#i-package" />
          </svg>
          <span>Produtos</span>
        </a>
        <a class="nav-item" href="/site/registros" data-route="movements">
          <svg>
            <use href="#i-swap" />
          </svg>
          <span>Registros</span>
          <small>8</small>
        </a>
        <p class="nav-label support-label">PREFERÊNCIAS</p>
        <a class="nav-item" href="/site/configuracoes" data-route="settings">
          <svg>
            <use href="#i-settings" />
          </svg>
          <span>Configurações</span>
        </a>
      </nav>
      <div class="sidebar-footer"><span class="status-dot"></span> Sistema operacional <small>v2.4.1</small></div>
    </aside>
    <button class="menu-overlay" id="menu-overlay" aria-label="Fechar menu"></button>