<%-include('cabecalho.ejs')%>

  <main class="main-content" id="conteudo-principal">
    <section class="page active" data-page="settings">
      <div class="page-heading">
        <div>
          <h1>Configurações</h1>
          <p>Escolha o tema da interface.</p>
        </div>
      </div>

      <div class="simple-grid settings-grid">
        <article class="simple-card theme-card">
          <span class="simple-icon">
            <svg>
              <use href="#i-settings" />
            </svg>
          </span>
          <div>
            <h2>Tema</h2>
            <p>Claro ou escuro</p>
          </div>
          <label class="theme-toggle">
            <span>Claro</span>
            <input id="theme-toggle" type="checkbox" aria-label="Ativar tema escuro">
            <span class="theme-switch" aria-hidden="true"></span>
            <span>Escuro</span>
          </label>
        </article>
      </div>
    </section>
  </main>

  <%-include('rodape.ejs')%>